# ============================================
# Microsoft Entra (Azure AD) Application
# ============================================
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ============================================
# Microsoft Teams Configuration
# (Provide TEAMS_CHAT_ID for group chats, or TEAMS_TEAM_ID + TEAMS_CHANNEL_ID for channels)
# ============================================
TEAMS_CHAT_ID=
TEAMS_TEAM_ID=
TEAMS_CHANNEL_ID=
# Teams Workflow / Incoming Webhook URL (for posting rich confirmation cards)
TEAMS_WEBHOOK_URL=

# ============================================
# User Role Mapping (Microsoft Graph User IDs)
# ============================================
TEST_CLIENT_USER_ID=
TEST_PM_USER_ID=
TEST_DEVELOPER_USER_ID=
# Single-user testing: allows client emoji reactions to approve issues as PM
ALLOW_SELF_APPROVAL=false


# ============================================
# Server Configuration
# ============================================
PORT=3000

# ============================================
# Webhook Configuration
# The public HTTPS URL where Microsoft Graph
# will send change notifications.
# Example: https://your-tunnel.example.com
# ============================================
WEBHOOK_PUBLIC_URL=

# ============================================
# Logging
# ============================================
LOG_LEVEL=info

# ============================================
# Database
# Path for SQLite database file (MVP)
# ============================================
DATABASE_PATH=./data/messages.db

# ============================================
# Google Gemini LLM (Multi-Key Pool & Role Breakdown)
# ============================================
# [Key 1: Primary] - Main active key for analyzing client messages, screenshots & error logs
GEMINI_API_KEY_1=
# [Key 2: Secondary Failover] - Takes over automatically if Key 1 hits rate limits (15 RPM / 429)
GEMINI_API_KEY_2=
# [Key 3: Tertiary Backup] - Emergency failover key if Keys 1 & 2 are both throttled
GEMINI_API_KEY_3=
# Fallback alias or comma-separated list
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ============================================
# Atlassian Jira Cloud (Phase 4 Ticket Creation)
# ============================================
# Your Atlassian Cloud URL, e.g.: https://your-company.atlassian.net
JIRA_BASE_URL=
# The email address used to log into Jira
JIRA_EMAIL=
# API Token generated from: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=
# The Jira project key (e.g. KAN, TEST, PROJ, SCRUM)
JIRA_PROJECT_KEY=
# Default issue type (e.g. Bug or Task)
JIRA_DEFAULT_ISSUE_TYPE=Task

# ============================================
# PM Follow-up SLA & Email Escalation
# ============================================
# SLA threshold in minutes before sending follow-up reminder if no PM reaction
PM_REMINDER_TIMEOUT_MINUTES=15

# (Optional) SMTP / Outlook Email Configuration
# If Microsoft Graph Mail.Send application permission is not yet granted in Azure,
# configure standard SMTP (e.g. Outlook/Office 365 or company SMTP) for email alerts:
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true


